# ── Required ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
PINECONE_API_KEY=

# ── Model / index (defaults are sensible) ─────────────────────────────────
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001
PINECONE_INDEX=zenshine-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Runtime ───────────────────────────────────────────────────────────────
APP_ENV=development
DEFAULT_TENANT=zenshine
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Syncs backend/knowledge/<tenant>/ into Pinecone on start-up (idempotent). Disable after the first run if you prefer.
AUTO_INGEST=true

# ── Optional ──────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0     # sessions + rate limits shared across instances (required for >1 instance)
# ADMIN_API_KEY=                          # required in production (>= 24 chars): protects /v1/admin/*
# METRICS_TOKEN=                          # bearer token for /metrics
# REQUIRE_API_KEY=false
# API_KEYS=key1,key2
# TRUSTED_PROXY_HOPS=1                    # CloudFront + ALB = 2
# LEADS_BACKEND=file                      # or dynamodb (+ LEADS_DYNAMODB_TABLE, LEADS_SNS_TOPIC_ARN, AWS_REGION)
# OTEL_EXPORTER_OTLP_ENDPOINT=
